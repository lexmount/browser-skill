# Copy to .env for local development. Do not commit real secrets.

# Lexmount browser runtime. Required for live browser sessions.
# LEXMOUNT_API_KEY=
# LEXMOUNT_PROJECT_ID=
# LEXMOUNT_BASE_URL=
# LEXMOUNT_REGION=
# LEXMOUNT_BROWSER_MODE=normal

# Optional: required only when using .ai/skills/notion-doc-reader locally.
# NOTION_ACCESS_TOKEN=
# NOTION_VERSION=2026-03-11

# Optional: required only when using .ai/skills/composing-data-insights image generation.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
